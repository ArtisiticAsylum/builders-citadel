{
  "name": "Citadel — brief sender (SKELETON — test with your own address first)",
  "meta": { "note": "Starting point, not plug-and-play. Import into n8n, attach YOUR Gmail credential to both Gmail nodes, set your subject filter, run once manually with a test draft addressed to yourself. This workflow sends drafts AS ADDRESSED — it does not check recipients. The guard lives at draft time (see AUTOMATION.md)." },
  "nodes": [
    {
      "name": "Every morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": { "rule": { "interval": [ { "field": "cronExpression", "expression": "30 7 * * *" } ] } }
    },
    {
      "name": "Find brief drafts",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [220, 0],
      "parameters": { "resource": "draft", "operation": "getAll", "returnAll": true },
      "credentials": { "gmailOAuth2": { "name": "ATTACH YOUR OWN GMAIL CREDENTIAL" } }
    },
    {
      "name": "Only today's subject",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [440, 0],
      "parameters": { "conditions": { "options": { "caseSensitive": false }, "conditions": [ { "leftValue": "={{ $json.message.subject }}", "rightValue": "Daily Brief", "operator": { "type": "string", "operation": "startsWith" } } ] } }
    },
    {
      "name": "Send the draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [660, 0],
      "parameters": { "resource": "draft", "operation": "send", "draftId": "={{ $json.id }}" },
      "credentials": { "gmailOAuth2": { "name": "ATTACH YOUR OWN GMAIL CREDENTIAL" } }
    }
  ],
  "connections": {
    "Every morning": { "main": [ [ { "node": "Find brief drafts", "type": "main", "index": 0 } ] ] },
    "Find brief drafts": { "main": [ [ { "node": "Only today's subject", "type": "main", "index": 0 } ] ] },
    "Only today's subject": { "main": [ [ { "node": "Send the draft", "type": "main", "index": 0 } ] ] }
  },
  "settings": {},
  "pinData": {}
}
